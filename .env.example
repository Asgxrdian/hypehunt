# HyperHunt environment template — copy to .env and fill in.
# The real .env is gitignored and NEVER committed (Bible Rule 1.2).
#
# CLIENT-SAFE (publishable — these two are the ONLY values that may
# reach the Flutter app, passed via --dart-define):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY (set with `supabase secrets set`, never in the app):
SUPABASE_SECRET_KEY=
RAWG_API_KEY=
ITAD_API_KEY=
KNOCK_SECRET_KEY=
# CheapShark requires no key.
